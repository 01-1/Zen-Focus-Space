[
  {
    "type": "text",
    "label": "Focus Space adds a live per-space stopwatch in the workspace indicator and a daily time-ratio bar at the sidebar foot."
  },
  {
    "type": "separator",
    "label": "Pause shortcut",
    "margin": "25px 0 15px 0"
  },
  {
    "type": "text",
    "label": "Pause or resume the stopwatch with a keypress — a function key like F9, or a letter plus a modifier like Ctrl, Alt, or Cmd (e.g. Alt+Shift+P). Leave blank to disable."
  },
  {
    "type": "string",
    "property": "extensions.focus-space.pause-shortcut",
    "label": "Pause / resume stopwatch",
    "placeholder": "F9",
    "defaultValue": "F9"
  },
  {
    "type": "separator",
    "label": "Auto-pause",
    "margin": "25px 0 15px 0"
  },
  {
    "type": "checkbox",
    "property": "extensions.focus-space.pause-on-blur",
    "label": "Pause while the window is inactive, and resume when it's back",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Time-ratio bar",
    "margin": "25px 0 15px 0"
  },
  {
    "type": "checkbox",
    "property": "extensions.focus-space.show-ratio-bar",
    "label": "Show the daily time-ratio bar at the sidebar foot",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Daily reset",
    "margin": "25px 0 15px 0"
  },
